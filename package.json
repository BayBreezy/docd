{
  "name": "docd-monorepo",
  "private": true,
  "workspaces": [
    "docd",
    "docs",
    "create-docd"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run docs:build",
    "changeset": "changeset",
    "clean": "node ./scripts/clean-workspaces.mjs",
    "clean:dry-run": "node ./scripts/clean-workspaces.mjs --dry-run",
    "dev": "bun run docs:dev",
    "dev:prepare": "nuxt prepare docs",
    "docs:build": "cd docs && nr build",
    "docs:dev": "cd docs && nr dev",
    "docs:download": "bun run ./scripts/download-llms-docs.ts",
    "docs:generate": "bun run --cwd docs generate",
    "docs:preview": "bun run --cwd docs preview",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "generate": "bun run docs:generate",
    "lint": "bun run lint:prepare && oxlint .",
    "lint:fix": "bun run lint:prepare && oxlint --fix .",
    "lint:prepare": "node ./scripts/prepare-nuxt-workspaces.mjs",
    "prepare": "husky",
    "preview": "bun run docs:preview",
    "release": "changeset publish"
  },
  "devDependencies": {
    "@antfu/ni": "^30.1.0",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "@commitlint/cli": "^21.0.2",
    "@commitlint/config-conventional": "^21.0.2",
    "@commitlint/types": "^21.0.1",
    "@types/node": "^26.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "nuxt": "^4.4.8",
    "nuxt-component-meta": "^0.17.2",
    "oxfmt": "^0.55.0",
    "oxlint": "^1.70.0",
    "oxlint-tsgolint": "^0.23.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vue": "latest"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,vue}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "oxlint --fix --no-error-on-unmatched-pattern"
    ],
    "*.{json,md,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "packageManager": "bun@1.3.14",
  "trustedDependencies": [
    "@morev/vue-transitions",
    "@parcel/watcher",
    "esbuild",
    "sharp",
    "unrs-resolver",
    "vue-demi"
  ]
}
